// =============================================================================
// Parameter Limit Profiles Schema
// =============================================================================

model ParameterLimitProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  
  limits      ParameterLimit[]
  projects    Project[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  
  @@map("parameter_limit_profiles")
}

model ParameterLimit {
  id         String  @id @default(uuid())
  profileId String
  profile   ParameterLimitProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  
  minValue         Float?
  maxValue         Float?
  rawWaterMinValue Float?
  rawWaterMaxValue Float?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([profileId, parameterId])
  @@index([profileId])
  @@index([parameterId])
  @@map("parameter_limits")
}
