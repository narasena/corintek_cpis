enum LogSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum LogSheetEntryRole {
  VALUE
  RAW_WATER
  NOTE
}

enum LogSheetPhotoType {
  BEFORE
  AFTER
}

model LogSheet {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  date   DateTime
  notes  String?
  status LogSheetStatus @default(DRAFT)

  entries        LogSheetEntry[]
  photos         LogSheetPhoto[]
  chemicalUsages ChemicalUsage[]

  replacedByUserId String?
  replacedBy       User?   @relation("LogSheetReplacedBy", fields: [replacedByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, date])
  @@map("log_sheets")
}

model LogSheetEntry {
  id         String   @id @default(uuid())
  logSheetId String
  logSheet   LogSheet @relation(fields: [logSheetId], references: [id])

  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  role LogSheetEntryRole @default(VALUE)

  valueType    ValueType
  numericValue Float?
  boolValue    Boolean?
  textValue    String?
  fileUrl      String?

  checkedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([logSheetId])
  @@index([parameterId])
  @@index([machineId])
  @@index([role])
  @@map("log_sheet_entries")
}

model LogSheetPhoto {
  id         String            @id @default(uuid())
  logSheetId String
  logSheet   LogSheet          @relation(fields: [logSheetId], references: [id])
  type       LogSheetPhotoType
  url        String
  caption    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([logSheetId])
  @@index([type])
  @@map("log_sheet_photos")
}
