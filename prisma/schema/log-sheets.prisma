enum LogSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum LogSheetEntryRole {
  VALUE
  RAW_WATER
  NOTE
}

enum LogSheetPhotoType {
  BEFORE
  AFTER
}

model LogSheet {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  date   DateTime
  notes  String?
  status LogSheetStatus @default(DRAFT)
  locked Boolean        @default(false)

  entries        LogSheetEntry[]
  photos         LogSheetPhoto[]
  chemicalUsages ChemicalUsage[]
  activeMachines LogSheetMachine[]

  replacedByUserId String?
  replacedBy       User?   @relation("LogSheetReplacedBy", fields: [replacedByUserId], references: [id])

  submittedAt       DateTime?
  submittedByUserId String?
  submittedBy       User?     @relation("LogSheetSubmittedBy", fields: [submittedByUserId], references: [id])

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("LogSheetApprovedBy", fields: [approvedByUserId], references: [id])

  technicianSignatureUrl   String?
  technicianSignedAt       DateTime?
  technicianSignedByUserId String?
  technicianSignedBy       User?   @relation("LogSheetTechnicianSignedBy", fields: [technicianSignedByUserId], references: [id])

  clientPicSignatureUrl   String?
  clientPicSignedAt       DateTime?
  clientPicSignedByUserId String?
  clientPicSignedBy       User?   @relation("LogSheetClientPicSignedBy", fields: [clientPicSignedByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, date])
  @@map("log_sheets")
}

model LogSheetEntry {
  id         String   @id @default(uuid())
  logSheetId String
  logSheet   LogSheet @relation(fields: [logSheetId], references: [id])

  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  role LogSheetEntryRole @default(VALUE)

  valueType    ValueType
  numericValue Float?
  boolValue    Boolean?
  textValue    String?
  fileUrl      String?

  checkedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([logSheetId])
  @@index([parameterId])
  @@index([machineId])
  @@index([role])
  @@map("log_sheet_entries")
}

model LogSheetPhoto {
  id         String            @id @default(uuid())
  logSheetId String
  logSheet   LogSheet          @relation(fields: [logSheetId], references: [id])
  type       LogSheetPhotoType
  url        String
  caption    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([logSheetId])
  @@index([type])
  @@map("log_sheet_photos")
}

model LogSheetMachine {
  id         String   @id @default(uuid())
  logSheetId String
  logSheet   LogSheet @relation(fields: [logSheetId], references: [id])

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id])

  createdAt DateTime @default(now())

  @@unique([logSheetId, machineId])
  @@map("log_sheet_machines")
}
