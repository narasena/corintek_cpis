// =============================================================================
// User Domain - MVP Schema
// =============================================================================

model User {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String?
  idNumber    String?
  email       String  @unique
  phoneNumber String  @unique
  password    String
  avatarUrl   String?

  role             UserRole
  employmentStatus EmploymentStatus

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)

  replacedLogSheets    LogSheet[]   @relation("LogSheetReplacedBy")
  submittedLogSheets   LogSheet[]   @relation("LogSheetSubmittedBy")
  approvedLogSheets    LogSheet[]   @relation("LogSheetApprovedBy")
  technicianSignedLogSheets LogSheet[] @relation("LogSheetTechnicianSignedBy")
  clientPicSignedLogSheets  LogSheet[] @relation("LogSheetClientPicSignedBy")
  approvedWorkReports  WorkReport[] @relation("WorkReportApprovedBy")
  attendances          Attendance[]
  projectAssignments   ProjectAssignment[]
  notifications        Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
  REPORTING
  DIRECTOR
  CLIENT_TECHNICIAN
  CLIENT_SUPERVISOR
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  FREELANCE
}
