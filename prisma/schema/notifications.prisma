// =============================================================================
// Notifications Domain - MVP Schema
// =============================================================================

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title    String
  message  String
  severity NotificationSeverity @default(INFO)
  source   Json

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // [M-01 Standardization] Uncomment for final refactoring
  // deletedAt DateTime?

  @@index([userId, isRead])
  @@map("notifications")
}

