// =============================================================================
// Project Domain - MVP Schema
// =============================================================================

model Project {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  name        String
  description String?
  quoteNumber String?
  poNumber    String?

  startDate DateTime
  endDate   DateTime?

  status       ProjectStatus       @default(PENDING)
  projectType  ProjectType         @default(UTAMA)
  contractType ProjectContractType @default(DIRECT)
  workCategory ProjectWorkCategory @default(OPERATIONAL)
  warrantyMonths Int?
  parentProjId String?

  parentProject Project?  @relation("ProjectAddendumParent", fields: [parentProjId], references: [id])
  addenda       Project[] @relation("ProjectAddendumParent")

  machines           Machine[]
  logSheets          LogSheet[]
  workReports        WorkReport[]
  labAnalyses        LabAnalysis[]
  summaryReports     SummaryReport[]
  parameterOverrides ProjectParameterOverride[]
  assignments        ProjectAssignment[]
  
  parameterLimitProfileId String?
  parameterLimitProfile   ParameterLimitProfile? @relation(fields: [parameterLimitProfileId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([parameterLimitProfileId])
  @@map("projects")
}

enum ProjectStatus {
  PENDING
  ONGOING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProjectType {
  UTAMA
  ADDENDUM
}

enum ProjectContractType {
  DIRECT
  SUBCONTRACT
}

enum ProjectWorkCategory {
  OPERATIONAL
  CONSTRUCTION
  AD_HOC
}

model ProjectAssignment {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      ProjectAssignmentRole
  isActive  Boolean @default(true)

  startDate DateTime?
  endDate   DateTime?

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
  @@map("project_assignments")
}

enum ProjectAssignmentRole {
  PROJECT_PIC
  TECHNICIAN
  CLIENT_PIC
}

model ProjectParameterOverride {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  // Overrides
  minValue         Float?
  maxValue         Float?
  rawWaterMinValue Float?
  rawWaterMaxValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, parameterId])
  @@map("project_parameter_overrides")
}
