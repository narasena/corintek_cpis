// =============================================================================
// Work Reports Domain
// =============================================================================

model WorkReport {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  date       DateTime @default(now())
  timeStart  String? // Jam Mulai (e.g. "10:00")
  timeEnd    String? // Jam Selesai (e.g. "17:30")
  zone       String? // Zone / Area (Text)
  situation  String // Kondisi/Situasi (Text)
  workDone   String // Pekerjaan yang dilakukan (Text)
  workResult String // Hasil pekerjaan (Text)

  status           WorkReportStatus @default(DRAFT)
  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?           @relation("WorkReportApprovedBy", fields: [approvedByUserId], references: [id])

  // Relations
  machines Machine[] // Implicit Many-to-Many

  // Photos (Reusing generic Photo approach if needed, or specific relation)
  // The roadmap says: "Integrate Photo Attachments (reuse LogSheetPhoto logic)"
  // But usually we want a specific table for WorkReportPhoto or make a polymorphic one.
  // Roadmap says "reuse LogSheetPhoto logic", which implies we might need a similar table `WorkReportPhoto`.
  photos WorkReportPhoto[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("work_reports")
}

enum WorkReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum WorkReportPhotoType {
  BEFORE
  AFTER
  GENERAL
}

model WorkReportPhoto {
  id           String     @id @default(uuid())
  workReportId String
  workReport   WorkReport @relation(fields: [workReportId], references: [id])

  url     String
  caption String?
  type    WorkReportPhotoType @default(GENERAL)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("work_report_photos")
}
