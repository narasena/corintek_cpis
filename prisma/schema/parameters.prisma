// =============================================================================
// Parameters Domain - MVP Schema
// =============================================================================

// ValueType enum - determines how parameter value is stored/displayed
enum ValueType {
  NUMBER  // Float values (temperature, pH, etc.)
  BOOLEAN // Yes/No, Running/Stop
  TEXT    // Free text values
}

// ParameterCategory - grouping for UI sections
enum ParameterCategory {
  UNIT_CONDENSOR
  UNIT_EVAPORATOR
  COOLING_WATER_QUALITY
  GENERAL_CONDITION
  JOB_DESCRIPTION
  CONSUMPTION
}

model Parameter {
  id           String            @id @default(uuid())
  name         String // e.g., "Temp (C°) In" - NOT unique to allow reuse across categories
  variableName String            @unique // e.g., "temp_c_in_cond" - unique identifier
  category     ParameterCategory
  valueType    ValueType
  unit         String? // e.g., "°C", "ppm", "µS"

  // Optional limit range for NUMBER type
  minValue Float?
  maxValue Float?

  // Optional raw-water limit range (used by COOLING_WATER_QUALITY)
  rawWaterMinValue Float?
  rawWaterMaxValue Float?

  // Display metadata
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  logSheetEntries LogSheetEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("parameters")
}
