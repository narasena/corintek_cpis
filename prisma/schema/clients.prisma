// =============================================================================
// Client Domain - MVP Schema
// =============================================================================

model Client {
  id          String  @id @default(uuid())
  name        String  @unique
  email       String?
  phoneNumber String?
  address     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("clients")
}
