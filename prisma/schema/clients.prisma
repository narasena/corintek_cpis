// =============================================================================
// Client Domain - MVP Schema
// =============================================================================

model Client {
  id          String  @id @default(uuid())
  name        String  @unique
  email       String?
  phoneNumber String?
  address     String?
  website     String? @db.VarChar(255)

  projects Project[]
  users    User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("clients")
}
