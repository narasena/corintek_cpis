enum LabAnalysisColumnKind {
  RAW_WATER
  CTW
  CHW
  OTHER
}

model LabAnalysis {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  date            DateTime
  attention       String?
  cc              String?
  customer        String?
  address         String?
  faxNumber       String?
  reportNumber    String?
  remarks         String?
  recommendations String?

  columns LabAnalysisColumn[]
  entries LabAnalysisEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, date])
  @@map("lab_analyses")
}

model LabAnalysisColumn {
  id            String      @id @default(uuid())
  labAnalysisId String
  labAnalysis   LabAnalysis @relation(fields: [labAnalysisId], references: [id])

  name         String
  kind         LabAnalysisColumnKind @default(OTHER)
  displayOrder Int                   @default(0)

  entries LabAnalysisEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([labAnalysisId])
  @@index([kind])
  @@map("lab_analysis_columns")
}

model LabAnalysisEntry {
  id            String      @id @default(uuid())
  labAnalysisId String
  labAnalysis   LabAnalysis @relation(fields: [labAnalysisId], references: [id])

  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  columnId String
  column   LabAnalysisColumn @relation(fields: [columnId], references: [id])

  valueType    ValueType
  numericValue Float?
  boolValue    Boolean?
  textValue    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([labAnalysisId, parameterId, columnId])
  @@index([labAnalysisId])
  @@index([parameterId])
  @@index([columnId])
  @@map("lab_analysis_entries")
}
