/**
 * Development Worker: development assets bucket only.
 *
 * Deploy with: npx wrangler deploy --config wrangler.development.jsonc
 * Never add a second bucket binding here.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corintek-cpis-assets-dev",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "corintek-cpis-dev-assets",
			"preview_bucket_name": "corintek-cpis-preview-assets"
		}
	]
}
