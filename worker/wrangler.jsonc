/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corintek-cpis-assets",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"r2_buckets": [
		{
			"binding": "DEV_BUCKET",
			"bucket_name": "corintek-cpis-dev-assets",
			"preview_bucket_name": "corintek-cpis-preview-assets",
		},
		{
			"binding": "PROD_BUCKET",
			"bucket_name": "corintek-cpis-prod-assets",
		},
	],
}
