model User {
  id               String           @id @default(uuid())
  firstName        String
  lastName         String?
  idNumber         String?
  email            String           @unique
  phoneNumber      String           @unique
  password         String
  role             UserRole
  employmentStatus EmploymentStatus
  avatarUrl        String?
  avatarPublicId   String?

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)

  assignees          ProjectAssignment[] @relation("Assignees")
  technicianAbsences TechnicianAbsence[]
  clientPersonnel    ClientPersonnel[]
  signatures         Signature[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
  DIRECTOR
  CLIENT_TECHNICIAN
  CLIENT_SUPERVISOR
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  FREELANCE
}
