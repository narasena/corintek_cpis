model Chemical {
  id          String          @id @default(uuid())
  code        String
  name        String
  type        ChemicalType
  description String?
  unit        String?
  usages      ChemicalUsage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@map("chemicals")
}

enum ChemicalType {
  BOILER_SYSTEM
  COOLING_SYSTEM
  CHEMICAL_CLEANING
  WASTE_WATER_TREATMENT
}

model ChemicalUsage {
  id                  String                 @id @default(uuid())
  machineId           String
  machine             Machine                @relation(fields: [machineId], references: [id])
  chemicalId          String
  chemical            Chemical               @relation(fields: [chemicalId], references: [id])
  dosage              Float
  logSheetId          String?
  logSheet            LogSheet?              @relation(fields: [logSheetId], references: [id])
  chillerDisinfectant ChillerCleaningReport? @relation("ChillerDisinfectant")
  chillerDescaling    ChillerCleaningReport? @relation("ChillerDescaling")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?

  @@index([machineId, chemicalId])
  @@index([chemicalId])
  @@index([logSheetId, machineId])
  @@map("chemical_usages")
}
