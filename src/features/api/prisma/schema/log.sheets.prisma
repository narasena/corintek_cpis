model LogSheet {
    id         String          @id @default(uuid())
    projectId  String
    project    Project         @relation(fields: [projectId], references: [id])
    notes      String?

    details     LogSheetDetail[]
    logSheetHistories LogSheetHistory[]
    notifications Notification[]

    PICSignatureId String      @unique
    PICSignature Signature @relation("LogSheetPIC", fields: [PICSignatureId], references: [id])
    clientPICSignatureId String @unique
    clientPICSignature Signature @relation("LogSheetClient",fields: [clientPICSignatureId], references: [id])
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheets")
    @@index([projectId])

}

model LogSheetHistory {
    id          String          @id @default(uuid())
    logSheetId   String
    logSheet     LogSheet         @relation(fields: [logSheetId], references: [id])
    status      LogSheetStatus
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheet_histories")
    @@index([logSheetId])
}

enum LogSheetStatus {
    DRAFT
    SUBMITTED
    APPROVED
}

model LogSheetDetail{
    id          String          @id @default(uuid())
    logSheetId   String
    logSheet     LogSheet         @relation(fields: [logSheetId], references: [id])
    machineId   String?
    machine     Machine?         @relation(fields: [machineId], references: [id])
    parameterId  String
    parameter   Parameter @relation(fields: [parameterId], references: [id])
    detailType  LogSheetDetailType
    checkTime   String?
    valueType    ValueType
    numericValue Float?
    boolValue   Boolean?
    textValue String?
    imgUrl      String?
    imgPublicId String?
    chemicalUsages ChemicalUsage[]  @relation("LogSheetChemicals")
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheet_details")
    @@index([logSheetId, machineId, parameterId])
    @@index([logSheetId, parameterId])
    @@index([machineId, parameterId])
    @@index([parameterId])
}

enum LogSheetDetailType {
    CHILLER_CONDENSER
    CHILLER_EVAPORATOR
    COOLING_TOWER_WATER_QUALITY
    COOLING_TOWER_CONDITION
    COOLING_TOWER_CLEANING
    COOLING_TOWER_CONSUMPTION
    OTHER
}