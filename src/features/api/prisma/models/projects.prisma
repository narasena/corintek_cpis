model Client {
    id          String          @id @default(uuid())
    name        String          @unique
    description String?
    avatarUrl   String?
    avatarPublicId String?
    email       String?
    phoneNumber String?
    address     String?
    websiteUrl  String?

    projects    Project[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("clients")
}

model Project {
    id          String          @id @default(uuid())
    parentId    String?         @map("parent_project_id")
    parent      Project?        @relation("ProjectAddendum", fields: [parentId], references: [id])
    addenda     Project[]       @relation("ProjectAddendum")
    clientId    String
    client      Client          @relation(fields: [clientId], references: [id])
    name        String
    description String?
    quoteNumber String
    PONumber    String
    startDate   DateTime
    endDate     DateTime
    type        ProjectType
    contractType ContractType
    workCategory WorkCategory
    warranty    Int?
    clientPICId    String
    clientPIC      User          @relation("ClientPIC", fields: [clientPICId], references: [id])
    technicianId   String
    technician     User          @relation("Technician", fields: [technicianId], references: [id])

    machines    Machine[]
    labReports  LabReport[]
    logSheets    LogSheet[]
    workReports WorkReport[]
    masterSettings MasterSetting[]
    cleaningReports ChillerCleaningReport[]
    projectReports     ProjectReport[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("projects")
    @@index([clientId, parentId])
    @@index([clientPICId])
    @@index([technicianId])
}

enum ProjectType {
    MAIN
    ADDENDUM
}

enum ContractType {
    DIRECT
    SUBCONTRACT
}

enum WorkCategory {
    OPERATIONAL
    CONSTRUCTION
    AD_HOC
    MAINTENANCE
}

model ProjectHistory {
    id          String          @id @default(uuid())
    projectId   String
    status      ProjectStatus
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("project_histories")
}

enum ProjectStatus {
    PENDING
    ONGOING
    PAUSED
    COMPLETED
    CANCELLED
}
