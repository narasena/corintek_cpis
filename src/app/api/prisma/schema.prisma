
generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
    id          String          @id @default(uuid())
    firstName   String          
    lastName    String?
    IDNumber    String?
    email       String          @unique
    phoneNumber String?         @unique
    password    String          
    role        UserRole
    employmentStatus EmploymentStatus
    avatarUrl   String?
    avatarPublicId String?

    isActive  Boolean         @default(false)
    isBlocked   Boolean         @default(false)

    technicianAbsences TechnicianAbsence[]
    clientPIC   Project[]      @relation("ClientPIC")
    technician  Project[]      @relation("Technician")
    signatures  Signature[]
    notifications   Notification[]
    auditLogs   AuditLog[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("users")
}

enum UserRole {
    ADMIN
    SUPERVISOR
    TECHNICIAN
    DIRECTOR
    CLIENT_PIC
    CLIENT_MANAGER
}

enum EmploymentStatus {
    PERMANENT
    CONTRACT
    FREELANCE
}

model Client {
    id          String          @id @default(uuid())
    name        String
    description String?
    avatarUrl   String?
    avatarPublicId String?
    email       String?
    phoneNumber String?
    address     String?
    websiteUrl  String?

    projects    Project[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("clients")
}

model Project {
    id          String          @id @default(uuid())
    parentId    String?         @map("parent_project_id")
    parent      Project?        @relation("ProjectAddendum", fields: [parentId], references: [id])
    addenda     Project[]       @relation("ProjectAddendum")
    clientId    String
    client      Client          @relation(fields: [clientId], references: [id])
    name        String
    description String?
    quoteNumber String
    PONumber    String
    startDate   DateTime
    endDate     DateTime
    type        ProjectType
    contractType ContractType
    workCategory WorkCategory
    warranty    Int?
    clientPICId    String
    clientPIC      User          @relation("ClientPIC", fields: [clientPICId], references: [id])
    technicianId   String
    technician     User          @relation("Technician", fields: [technicianId], references: [id])

    machines    Machine[]
    labReports  LabReport[]
    logSheets    LogSheet[]
    workReports WorkReport[]
    masterSettings MasterSetting[]
    cleaningReports ChillerCleaningReport[]
    reports     Report[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("projects")
    @@index([clientId, parentId])
    @@index([clientPICId])
    @@index([technicianId])
}

enum ProjectType {
    MAIN
    ADDENDUM
}

enum ContractType {
    DIRECT
    SUBCONTRACT
}

enum WorkCategory {
    OPERATIONAL
    CONSTRUCTION
    AD_HOC
    MAINTENANCE
}

model ProjectHistory {
    id          String          @id @default(uuid())
    projectId   String
    status      ProjectStatus
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("project_histories")
}

enum ProjectStatus {
    PENDING
    ONGOING
    PAUSED
    COMPLETED
    CANCELLED
}

model TechnicianAbsence {
    id          String          @id @default(uuid())
    technicianId   String
    technician     User         @relation(fields: [technicianId], references: [id])
    clockIn     DateTime
    clockInImgUrl String
    clockInPublicId String
    clockOut     DateTime?
    clockOutImgUrl String?
    clockOutPublicId String?
    totalHours   Float
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("technician_absences")
}

model Machine {
    id          String          @id @default(uuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id])
    type        MachineType
    brand       String?
    model       String?
    serialNumber String?

    machineHistories MachineHistory[]
    chemicalUsages  ChemicalUsage[]
    labReportDetails LabReportDetail[]
    logSheetDetails LogSheetDetail[]


    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("machines")
    @@index([projectId])
}
enum MachineType {
    CHILLER
    COOLING_TOWER
}


model MachineHistory {
    id          String          @id @default(uuid())
    machineId   String
    machine     Machine         @relation(fields: [machineId], references: [id])
    status      MachineStatus
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("machine_histories")
    @@index([machineId])
}

enum MachineStatus {
    RUNNING
    IDLE
    MAINTENANCE
}

model Chemical {
    id          String          @id @default(uuid())
    code        String
    name        String
    type        ChemicalType
    description String?
    unit        String?
    usages      ChemicalUsage[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("chemicals")
}

enum ChemicalType {
    BOILER_SYSTEM
    COOLING_SYSTEM
    CHEMICAL_CLEANING
    WASTE_WATER_TREATMENT
}

model ChemicalUsage {
    id          String          @id @default(uuid())
    machineId   String
    machine     Machine         @relation(fields: [machineId], references: [id])
    chemicalId  String
    chemical    Chemical        @relation(fields: [chemicalId], references: [id])
    dosage      Float
    coolingTowerLogSheetId   String
    coolingTowerLogSheet     LogSheetDetail         @relation("LogSheetChemicals",fields: [coolingTowerLogSheetId], references: [id])
    chillerDisinfectant  ChillerCleaningReport?         @relation("ChillerDisinfectant")
    chillerDescaling     ChillerCleaningReport?         @relation("ChillerDescaling")
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("chemical_usages")
    @@index([machineId, chemicalId])
    @@index([chemicalId])
    @@index([coolingTowerLogSheetId,machineId])
}

model LabReport {
    id          String          @id @default(uuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id])
    attention   String?
    carbonCopy  String?
    faxNumber   String?
    labReportNumber String
    remarks     Json
    comments     Json?
    recommendations Json?

    labReportDetails LabReportDetail[]
    fileUrl     String?
    filePublicId String?

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("lab_reports")
    @@index([projectId])
}

model LabReportDetail {
    id          String          @id @default(uuid())
    labReportId   String
    labReport     LabReport         @relation(fields: [labReportId], references: [id])
    machineId   String?
    machine     Machine?         @relation(fields: [machineId], references: [id])
    parameterId  String
    parameter   Parameter @relation(fields: [parameterId], references: [id])
    valueType    ValueType
    numericValue Float?
    boolValue   Boolean?
    textValue String?
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("lab_report_details")
    @@index([labReportId, machineId, parameterId])
    @@index([labReportId, parameterId])
    @@index([machineId, parameterId])
    @@index([parameterId])
}

enum ValueType {
    NUMBER
    TEXT
    BOOLEAN
}

model Parameter {
    id          String          @id @default(uuid())
    parameter   String          @unique
    valueType   ValueType
    unit        String?
    type        ParameterType
    groupId     String?
    group       ParameterGroup? @relation(fields: [groupId], references: [id])
    labReportDetails LabReportDetail[]
    limits      ParameterLimit[]
    settings    MasterSettingDetail[]
    logSheetDetails LogSheetDetail[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("parameters")
    @@index([groupId])
}

enum ParameterType {
    LAB_REPORT
    LOG_SHEET
    MASTER_SETTING
    MACHINE_MONITORING
    OTHER
}

model ParameterGroup {
    id          String          @id @default(uuid())
    name        String
    parameters  Parameter[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("parameter_groups")
}

model StandardMethod {
    id          String          @id @default(uuid())
    methodName  String
    year        Int
    version     String
    isActive    Boolean         @default(true)
    description Json?

    limitParameters  ParameterLimit[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("standard_methods")
}

model ParameterLimit {
    id          String          @id @default(uuid())
    parameterId  String
    parameter   Parameter @relation(fields: [parameterId], references: [id])
    methodId    String?
    method      StandardMethod? @relation(fields: [methodId], references: [id])
    valueType    ValueType
    minValue        Float?
    maxValue        Float?
    booleanValue    Boolean?
    textValue     String?
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("parameter_limits")
    @@index([parameterId])
}

model MasterSetting {
    id          String          @id @default(uuid())
    name        String
    projectId   String?
    project     Project?         @relation(fields: [projectId], references: [id])
    details     MasterSettingDetail[]

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("master_settings")
    @@index([projectId])
}

model MasterSettingDetail {
    id          String          @id @default(uuid())
    masterSettingId   String
    masterSetting     MasterSetting         @relation(fields: [masterSettingId], references: [id])
    parameterId  String
    parameter   Parameter @relation(fields: [parameterId], references: [id])
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("master_setting_details")
    @@index([masterSettingId, parameterId])
    @@index([parameterId])
}

model LogSheet {
    id         String          @id @default(uuid())
    projectId  String
    project    Project         @relation(fields: [projectId], references: [id])
    notes      String?

    details     LogSheetDetail[]
    logSheetHistories LogSheetHistory[]
    notifications Notification[]

    PICSignatureId String      @unique
    PICSignature Signature @relation("LogSheetPIC", fields: [PICSignatureId], references: [id])
    clientPICSignatureId String @unique
    clientPICSignature Signature @relation("LogSheetClient",fields: [clientPICSignatureId], references: [id])
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheets")
    @@index([projectId])

}

model LogSheetHistory {
    id          String          @id @default(uuid())
    logSheetId   String
    logSheet     LogSheet         @relation(fields: [logSheetId], references: [id])
    status      LogSheetStatus
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheet_histories")
    @@index([logSheetId])
}

enum LogSheetStatus {
    DRAFT
    SUBMITTED
    APPROVED
}

model LogSheetDetail{
    id          String          @id @default(uuid())
    logSheetId   String
    logSheet     LogSheet         @relation(fields: [logSheetId], references: [id])
    machineId   String?
    machine     Machine?         @relation(fields: [machineId], references: [id])
    parameterId  String
    parameter   Parameter @relation(fields: [parameterId], references: [id])
    detailType  LogSheetDetailType
    checkTime   String?
    valueType    ValueType
    numericValue Float?
    boolValue   Boolean?
    textValue String?
    imgUrl      String?
    imgPublicId String?
    chemicalUsages ChemicalUsage[]  @relation("LogSheetChemicals")
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("log_sheet_details")
    @@index([logSheetId, machineId, parameterId])
    @@index([logSheetId, parameterId])
    @@index([machineId, parameterId])
    @@index([parameterId])
}

enum LogSheetDetailType {
    CHILLER_CONDENSER
    CHILLER_EVAPORATOR
    COOLING_TOWER_WATER_QUALITY
    COOLING_TOWER_CONDITION
    COOLING_TOWER_CLEANING
    COOLING_TOWER_CONSUMPTION
    OTHER
}

model ChillerCleaningReport {
    id          String          @id @default(uuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id])
    zone        String?
    workToDo    String
    logSheetNotes   Json
    chemicalStartTime DateTime
    chemicalEndTime DateTime
    chemicalTotalTime   Int
    disinfectantChemicalId    String    @unique    
    disinfectantChemical    ChemicalUsage @relation("ChillerDisinfectant",fields: [disinfectantChemicalId], references: [id])
    descalingChemicalId    String       @unique
    descalingChemical    ChemicalUsage @relation("ChillerDescaling",fields: [descalingChemicalId], references: [id])
    
    chemicalNotes   Json
    endTime     DateTime
    beforeBrushingNotes Json
    afterBrushingNotes  Json
    PICNotes    Json
    clientNotes Json

    PICSignatureId String      @unique
    PICSignature Signature @relation("ChillerCleaningReportPIC", fields: [PICSignatureId], references: [id])
    clientPICSignatureId String @unique
    clientPICSignature Signature @relation("ChillerCleaningReportClient",fields: [clientPICSignatureId], references: [id])

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("cleaning_reports")
}

model WorkReport {
    id          String          @id @default(uuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id])
    zone        String?
    startTime   DateTime
    endTime     DateTime
    type        MachineType 
    currentCondition String
    workDone    String
    endResult   String
    photos      WorkReportPhoto[]
    PICSignatureId String       @unique
    PICSignature Signature     @relation("WorkReportPIC",fields: [PICSignatureId], references: [id])
    clientPICSignatureId String @unique
    clientPICSignature Signature @relation("WorkReportClient",fields: [clientPICSignatureId], references: [id])

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("work_reports")
    @@index([projectId])
}

model WorkReportPhoto {
    id          String          @id @default(uuid())
    workReportId   String
    workReport     WorkReport         @relation(fields: [workReportId], references: [id])
    imgUrl      String
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("work_report_photos")
    @@index([workReportId])
}

model Signature {
    id          String          @id @default(uuid())
    signerId    String
    signer      User         @relation(fields: [signerId], references: [id])
    imgUrl      String
    publicId    String
    workReportPICSignature      WorkReport?    @relation("WorkReportPIC", map: "work_report_pic_signature_id")
    workReportClientSignature   WorkReport?    @relation("WorkReportClient", map: "work_report_client_signature_id")
    logSheetPICSignature        LogSheet?      @relation("LogSheetPIC", map: "log_sheet_pic_signature_id")
    logSheetClientSignature     LogSheet?     @relation("LogSheetClient", map: "log_sheet_client_signature_id")
    chillerCleaningReportPICSignature   ChillerCleaningReport? @relation("ChillerCleaningReportPIC", map: "chiller_cleaning_report_pic_signature_id")
    chillerCleaningReportClientSignature ChillerCleaningReport? @relation("ChillerCleaningReportClient", map: "chiller_cleaning_report_client_signature_id")
    
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("signatures")
    @@index([signerId])
}

model Notification {
    id          String          @id @default(uuid())
    technicianId String
    technician  User         @relation(fields: [technicianId], references: [id])
    logSheetId   String?
    logSheet     LogSheet?         @relation(fields: [logSheetId], references: [id])
    message     String
    isRead      Boolean         @default(false)
    createdAt   DateTime        @default(now())
    @@map("notifications")
    @@index([technicianId, logSheetId])
    @@index([logSheetId])
}

model AuditLog {
    id          String          @id @default(uuid())
    userId      String
    user        User         @relation(fields: [userId], references: [id])
    action      String
    resourceId  String?
    details     Json?
    createdAt   DateTime        @default(now())
    @@map("audit_logs")
    @@index([userId])
}

model Report {
    id          String          @id @default(uuid())
    projectId   String
    project     Project         @relation(fields: [projectId], references: [id])
    data        Json
    fileUrl   String
    filePublicId String
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
    deletedAt  DateTime?
    @@map("reports")
    @@index([projectId])
}

