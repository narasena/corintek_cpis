# E2E Test Environment Variables
# Copy this file to .env.e2e.local and fill in the values

# Admin user credentials for testing admin override flows
E2E_ADMIN_EMAIL=admin@corintek.test
E2E_ADMIN_PASSWORD=your-admin-password

# Technician user credentials for testing standard log sheet flows
E2E_TECHNICIAN_EMAIL=technician@corintek.test
E2E_TECHNICIAN_PASSWORD=your-technician-password

# Client PIC user credentials for testing signature flows
E2E_CLIENT_PIC_EMAIL=client-pic@client.test
E2E_CLIENT_PIC_PASSWORD=your-client-pic-password

# Project ID to use for E2E tests (must exist in database)
E2E_PROJECT_ID=your-project-uuid
